{
  "name": "angelina-travel-toolbox",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "main": "apps/desktop/electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "preview": "vite preview",
    "package:win": "npm run build && electron-builder --win nsis --x64 --config.directories.output=release/installer",
    "package:win:portable": "npm run build && electron-builder --win portable --x64 --config.directories.output=release/program-only",
    "package:win:bundle": "node scripts/package-windows.cjs",
    "build:default-source": "node scripts/rebuild-default-source.cjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "fuse.js": "^7.5.0",
    "marked": "^18.0.11",
    "pinyin-pro": "^3.29.3",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.angelina.traveltoolbox",
    "productName": "阿洁的旅行工具箱",
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/**/*",
      "dist/renderer/**/*",
      "runtime-template/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "apps/desktop/renderer/assets/angelina-travel-suitcase.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "阿洁的旅行工具箱-Setup-${version}.${ext}"
    }
  }
}
